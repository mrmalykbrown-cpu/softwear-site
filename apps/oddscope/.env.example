# ---------------------------------------------------------------------------
# Database — PostgreSQL
# ---------------------------------------------------------------------------
# Prisma speaks the Postgres wire protocol, so these are Postgres connection
# strings — NOT the Supabase REST/PostgREST URL and NOT the anon key. This app
# never uses supabase-js; Prisma owns every query, so the project API URL and
# its keys are not needed anywhere in this codebase.
#
# Get the strings from: Supabase dashboard -> Project Settings -> Database ->
# Connection string -> "Prisma" tab, which fills in the region and username for
# you. Paste the password in; never commit it.
#
# DATABASE_URL is what the app uses at runtime: the TRANSACTION pooler on port
# 6543. pgbouncer=true tells Prisma to stop using prepared statements, which a
# transaction-mode pooler cannot support; connection_limit=1 keeps a serverless
# instance from opening a pool it will never reuse.
#
# DIRECT_URL is what Prisma Migrate uses for DDL: the SESSION pooler, port 5432.
#
# Both use the *pooler* host on purpose. The direct host, db.<ref>.supabase.co,
# now resolves IPv6-only, and Vercel's functions are IPv4-only — pointing
# DIRECT_URL there gives a "Can't reach database server" on every migration.
# Only use it if you are certain your network has IPv6.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------------
# NextAuth
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
# Leave both blank to hide the "Continue with Google" button entirely.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Anthropic — server-side only. This value must never reach a client bundle.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
# Optional overrides. The web-search tool version is pinned here so it can be
# rolled forward without a code change: claude-sonnet-4-6 also supports the
# newer "web_search_20260209" variant, which adds dynamic result filtering.
ANTHROPIC_MODEL="claude-sonnet-4-6"
ANTHROPIC_WEB_SEARCH_TOOL="web_search_20250305"

# ---------------------------------------------------------------------------
# Whop — checkout and subscription management
# ---------------------------------------------------------------------------
# The hosted checkout page users are sent to when the trial ends.
WHOP_CHECKOUT_URL="https://whop.com/checkout/plan_xxxxxxxx"
# Signing secret from the Whop dashboard webhook settings.
WHOP_WEBHOOK_SECRET=""
# Where "Manage subscription" points. Defaults to https://whop.com/orders
WHOP_PORTAL_URL="https://whop.com/orders"

# ---------------------------------------------------------------------------
# Screenshot storage (optional)
# ---------------------------------------------------------------------------
# With a Vercel Blob token, screenshots are uploaded and only the URL is stored.
# Without one, the compressed data URL is stored on the Analysis row instead,
# which works everywhere but grows the database.
BLOB_READ_WRITE_TOKEN=""
