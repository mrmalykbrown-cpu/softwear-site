{
  "name": "softwear-music-art",
  "version": "0.1.0",
  "private": true,
  "description": "Music-art app: set album covers as a phone/desktop wallpaper with smooth transitions, plus a liquid-glass Now Playing widget. Android (Capacitor) + Windows (Electron).",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron": "electron .",
    "electron:dev": "next build && electron .",
    "dist:win": "next build && electron-builder --win"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.6",
    "@capacitor/core": "^7.6.6",
    "@capacitor/haptics": "^7.0.5",
    "@radix-ui/react-slot": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "motion": "^12.40.0",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "three": "^0.172.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.6",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.172.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  },
  "build": {
    "appId": "com.softwear.prism",
    "productName": "Prism",
    "directories": {
      "output": "dist-win",
      "buildResources": "build-win"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build-win/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Prism"
    }
  }
}
