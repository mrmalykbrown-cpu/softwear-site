<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget styled as an Apple-Music-style "Recently Played" card:
     coral framed panel, large rounded album art, label + title, a live synced
     lyric line and a frosted Play pill. RemoteViews-safe (no plain View). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- album art -->
        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_widget_art" />

        <!-- right column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="4dp">

            <!-- label + sparkle -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="RECENTLY PLAYED"
                    android:textColor="#8CFFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="💫"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- track title -->
            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="#F2FFFFFF"
                android:textSize="24sp" />

            <!-- live synced lyric line -->
            <TextView
                android:id="@+id/widget_lyric"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#66000000"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="6"
                android:text="♪"
                android:textColor="#D6FFFFFF"
                android:textSize="13sp" />

            <!-- Play pill -->
            <LinearLayout
                android:id="@+id/widget_play"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/widget_play_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="22dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp">

                <ImageView
                    android:id="@+id/widget_play_icon"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:contentDescription="Play or pause"
                    android:src="@drawable/ic_widget_play" />

                <TextView
                    android:id="@+id/widget_play_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Play"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- music note, top-right -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:paddingEnd="2dp"
        android:text="♫"
        android:textColor="#F2FFFFFF"
        android:textSize="20sp" />
</FrameLayout>
