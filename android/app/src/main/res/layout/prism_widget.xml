<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- headline (track) — mirrors the in-app lyric/title line -->
    <TextView
        android:id="@+id/widget_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingBottom="12dp"
        android:text="@string/app_name"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- meta: art + artist + eq -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_widget_art" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:text="Tap to open"
            android:textColor="#B8FFFFFF"
            android:textSize="13sp" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="26dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_eq" />
    </LinearLayout>

    <!-- waveform (the "time") -->
    <ImageView
        android:id="@+id/widget_wave"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginTop="12dp"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_wave" />

    <!-- transport -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_prev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_btn"
            android:contentDescription="Previous"
            android:padding="11dp"
            android:src="@drawable/ic_widget_prev" />

        <ImageView
            android:id="@+id/widget_play"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/widget_btn"
            android:contentDescription="Play or pause"
            android:padding="14dp"
            android:src="@drawable/ic_widget_play" />

        <ImageView
            android:id="@+id/widget_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_btn"
            android:contentDescription="Next"
            android:padding="11dp"
            android:src="@drawable/ic_widget_next" />
    </LinearLayout>

    <!-- chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_chip_lyrics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            android:text="Lyrics"
            android:textColor="#E6FFFFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_chip_wall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_chip"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            android:text="Wallpaper"
            android:textColor="#E6FFFFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_chip_lib"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_chip"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            android:text="Library"
            android:textColor="#E6FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
