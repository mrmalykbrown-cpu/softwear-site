<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted glass panel: lighter sheen at the top fading to a darker translucent
     base, with a subtle rim — mirrors the in-app liquid-glass widget. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#3AFFFFFF"
        android:centerColor="#C8141420"
        android:endColor="#E60B0B12"
        android:centerY="0.18" />
    <corners android:radius="34dp" />
    <stroke android:width="1dp" android:color="#33FFFFFF" />
</shape>
