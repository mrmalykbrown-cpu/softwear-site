<?xml version="1.0" encoding="utf-8"?>
<!-- Coral "Recently Played" card: a dark rounded frame with a bright coral
     inset, mirroring the reference design. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2A0B0C" />
            <corners android:radius="34dp" />
        </shape>
    </item>
    <item
        android:left="5dp"
        android:top="5dp"
        android:right="5dp"
        android:bottom="5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FF6E73"
                android:endColor="#FB4A52" />
            <corners android:radius="29dp" />
        </shape>
    </item>
</layer-list>
